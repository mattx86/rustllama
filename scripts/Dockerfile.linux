# Rocky Linux 10 build environment for rustllama's Linux builds and tests
# — headless (CPU server/CLI) and the native egui GUI. The GUI is now
# egui/eframe (crates/rustllama-gui: eframe 0.29 with glow + winit, rfd
# file dialogs) — NOT Tauri/webkit — so the heavy webkit2gtk / libsoup /
# librsvg / GTK3 web stack is gone. egui links a small OpenGL + windowing
# graph instead: mesa GL/EGL, X11 + Wayland client libs, libxkbcommon,
# fontconfig/freetype for text, and D-Bus (rfd's xdg-desktop-portal file
# dialogs bind libdbus at build; the portal itself is a runtime dep the
# target host provides).
#
# Rocky 10 (RHEL 10) is the target FLOOR: its mesa + glibc 2.39 are the
# oldest we build against, so binaries built here need glibc 2.39+ (el10 /
# Ubuntu 24.04 / Fedora 40+). This is the Linux counterpart to the Windows
# oneAPI/MSVC toolchain used by scripts/build.bat.
#
# Build:  docker build -t rustllama-build-linux -f scripts/Dockerfile.linux scripts
# (scripts/build-linux-docker.bat does this for you.)
FROM rockylinux/rockylinux:10

# CRB + EPEL carry the -devel packages for the egui/GL build deps below.
# RHEL 10 ships a modern gcc (14) by default, so no gcc-toolset is needed.
RUN dnf -y install dnf-plugins-core \
    && dnf config-manager --set-enabled crb \
    && dnf -y install epel-release \
    && dnf -y install --setopt=install_weak_deps=False \
        gcc gcc-c++ make cmake perl-core git which \
        curl ca-certificates pkgconf-pkg-config file patchelf \
        mesa-libGL-devel mesa-libEGL-devel libxkbcommon-devel \
        libX11-devel libXcursor-devel libXrandr-devel libXi-devel \
        wayland-devel libxcb-devel dbus-devel fontconfig-devel freetype-devel \
    && dnf clean all && rm -rf /var/cache/dnf

# Rust via rustup. rust-toolchain.toml (stable) drives the toolchain;
# rustup auto-installs it on first cargo invocation.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y \
        --profile minimal --default-toolchain stable \
    && rustup component add rustfmt clippy \
    && rustc --version && cargo --version

WORKDIR /work
