# Dedicated GPU build image: the standard Rocky 10 build image PLUS the
# NVIDIA CUDA Toolkit (nvcc + static cudart) and Intel oneAPI DPC++
# (icx/icpx) — so it can compile BOTH GPU backends: the native CUDA
# kernels (rustllama-kernels-cuda) and the SYCL kernels on Linux.
#
# Large (~several GB) — use it only for GPU-backend builds; the plain
# Dockerfile.linux image stays small for CPU/GUI builds. Compiling here
# validates the kernels *build*; EXECUTION still needs the physical GPU
# (an NVIDIA driver for CUDA, an Intel GPU + Level Zero for SYCL) — which
# a Docker container on a non-GPU / Windows host does not have.
#
# Build:  docker build -t rustllama-build-gpu -f scripts/Dockerfile.linux-gpu scripts
FROM rustllama-build-linux

# ---- NVIDIA CUDA Toolkit (nvcc + static cudart) --------------------------
RUN dnf -y install dnf-plugins-core \
    && dnf config-manager --add-repo https://developer.download.nvidia.com/compute/cuda/repos/rhel10/x86_64/cuda-rhel10.repo \
    && dnf -y install cuda-nvcc-13-0 cuda-cudart-devel-13-0 cuda-cccl-13-0 \
    && dnf clean all && rm -rf /var/cache/dnf
ENV CUDA_PATH=/usr/local/cuda-13.0 \
    CUDACXX=/usr/local/cuda-13.0/bin/nvcc \
    PATH=/usr/local/cuda-13.0/bin:$PATH

# ---- Intel oneAPI DPC++ (icx/icpx) ---------------------------------------
RUN rpm --import https://yum.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB \
    && printf '[oneAPI]\nname=Intel oneAPI\nbaseurl=https://yum.repos.intel.com/oneapi\nenabled=1\ngpgcheck=1\nrepo_gpgcheck=1\ngpgkey=https://yum.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB\n' > /etc/yum.repos.d/oneAPI.repo \
    && dnf -y install intel-oneapi-compiler-dpcpp-cpp \
    && dnf clean all && rm -rf /var/cache/dnf
ENV ONEAPI_ROOT=/opt/intel/oneapi \
    PATH=/opt/intel/oneapi/compiler/latest/bin:$PATH

RUN nvcc --version | tail -2 && (icx --version 2>/dev/null | head -1 || echo "icx: source setvars in the build")
WORKDIR /work
