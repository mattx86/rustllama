; Module-definition file for rsl_kernels.dll.
;
; Lists every extern "C" function the DLL exports for consumption by
; the Rust crate's FFI shims. Needed because we build the DLL with
; icx (clang-cl mode) without per-declaration `__declspec(dllexport)`
; — the linker uses this file to populate the export table + import
; lib (.lib) for downstream Rust consumers.
;
; KEEP IN SYNC with the function list in `include/rsl_kernels.h`.
; If a new entry is added there, add it here too. The build will
; fail loudly at the Rust-side link step (`error LNK2019: unresolved
; external symbol rsl_xxx`) if anything is missing.

LIBRARY rsl_kernels
EXPORTS
    ; Stream / device lifecycle
    rsl_stream_create
    rsl_stream_destroy
    rsl_stream_backend
    rsl_stream_sycl_queue
    rsl_stream_sycl_device
    rsl_stream_sycl_context
    rsl_sycl_device_count
    rsl_sycl_device_info
    rsl_consume_error_count
    rsl_consume_last_l0_import_code
    rsl_consume_last_usm_alloc_diag
    rsl_get_last_error_message

    ; USM allocation
    rsl_usm_alloc_shared
    rsl_usm_free
    rsl_usm_alloc_device_from_host

    ; Host-pointer kernels
    rsl_gemm_f16
    rsl_gemm_q4k_f16
    rsl_gemm_q8_0_f16
    rsl_rmsnorm
    rsl_rope
    rsl_softmax_attn
    rsl_silu_mul
    rsl_embedding_lookup
    rsl_sample_argmax

    ; NVFP4
    rsl_dequant_nvfp4
    rsl_matvec_nvfp4_f16

    ; USM-resident kernels
