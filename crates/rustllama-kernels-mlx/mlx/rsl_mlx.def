; Module-definition file for rsl_mlx.dll (Windows stub) + the export
; name list the no-op stub generator reads on every non-Apple-Silicon
; target.
;
; Lists every extern "C" function the native MLX/Metal shim exports for
; consumption by the Rust crate's FFI shims. On Windows (and any host
; where we build the DLL/`.dylib` stub via a `.def`) the linker uses this
; file to populate the export table + import lib (.lib) for downstream
; Rust consumers. On the aarch64-apple-darwin REAL path the symbols are
; exported by default C ABI visibility from `mlx/rsl_mlx.mm`, so this file
; is consumed there only as the authoritative name list (build.rs also
; parses it to emit the no-op stub on non-Apple hosts).
;
; KEEP IN SYNC with the function list in `mlx/rsl_mlx.h`, the `extern "C"`
; block in `src/lib.rs`, and the entry points in `mlx/rsl_mlx.mm`. If a new
; entry is added in one place, add it in all four. A missing symbol fails
; loudly at the Rust-side link step (`unresolved external symbol rsl_mlx_*`).

LIBRARY rsl_mlx
EXPORTS
    ; Device query
    rsl_mlx_device_count
    rsl_mlx_device_info
    rsl_mlx_consume_error_count

    ; Host-pointer reference kernels (establish the FFI/parity pattern)
    rsl_mlx_rmsnorm_f32
    rsl_mlx_matvec_f32

    ; Stream / device-buffer lifecycle (device-resident path)
    rsl_mlx_stream_create
    rsl_mlx_stream_destroy
    rsl_mlx_malloc_from_host
    rsl_mlx_malloc_device
    rsl_mlx_free
    rsl_mlx_memcpy_h2d
    rsl_mlx_memcpy_d2h

    ; PrismML PTQ1_0 (Bonsai ternary) + Prism Hadamard
    rsl_mlx_matvec_ptq1_0_packed_f32
    rsl_mlx_matvec_ptq1_0_packed_f32_batched
    rsl_mlx_hadamard_forward

    ; Packed-quant matvecs (single + batched), one entry pair per quant.
    ; Mirrors the CudaPackedKind / MlxPackedKind variant set.
    rsl_mlx_matvec_q8_0_packed_f32
    rsl_mlx_matvec_q8_0_packed_f32_batched
    rsl_mlx_matvec_q4_k_packed_f32
    rsl_mlx_matvec_q4_k_packed_f32_batched
